# PostgreSQL connection string used by Prisma and NextAuth.
DATABASE_URL="postgresql://user:password@localhost:5432/studzstock"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="65sd4f6a4f9a89f1a9s81fd61as61fd1as9df189s"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional). Leave blank to disable the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Set to true in the client bundle to show the "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_ENABLED=""

# Set to "true" to put the whole app into maintenance mode via middleware.
MAINTENANCE_MODE="false"

# Optional seed overrides for `npm run db:seed`
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME=""

# StudzStock inventory
# Daily email through Resend (https://resend.com). Without RESEND_API_KEY emails are only previewed, never sent.
RESEND_API_KEY=""
# Sender, on a domain verified in Resend
INVENTORY_EMAIL_FROM="StudzStock <inventory@studzpeptides.com>"
# Site address used for links in the email (falls back to NEXTAUTH_URL)
INVENTORY_BASE_URL=""
# Vercel Cron sends this as "Authorization: Bearer ..." to /api/inventory/cron/daily-email. Generate a long random value.
CRON_SECRET=""
